# =============================================================
# BRACE-CPU .gitignore
# Source is tracked; environments, datasets, model weights,
# raw experiment output and OS/editor junk are not.
# =============================================================

# ---------- Python environments ----------
.venv/
venv/
env/
.env/
.python-version

# ---------- Python bytecode / build ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# ---------- Test / type-check / lint caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
junit*.xml

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Datasets (regenerable) ----------
data/
brace/data/
*.npz
*.npy
*.h5
*.hdf5
*.parquet
*.feather

# ---------- Model checkpoints / weights ----------
checkpoints/
brace/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.joblib

# ---------- Raw / intermediate experiment output ----------
results/raw/
results/rebuild/
results/processed/repro_backup/
brace/results/
*.log
nohup.out
*.pid

# ---------- LaTeX / paper build artifacts ----------
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
paper/build/
paper/out/

# ---------- OS junk ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.sw?

# ---------- Temp / backup / partial files ----------
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*~
*.part
*.crdownload
.cache/

# ---------- Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.yaml
secrets.yml
